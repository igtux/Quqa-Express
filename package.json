{
  "name": "quqa-express",
  "productName": "quqa-express",
  "version": "0.1.0-beta.8",
  "description": "Offline, single-user SSH terminal for the desktop.",
  "license": "Apache-2.0",
  "author": "AURA and the quqa-express contributors",
  "homepage": "https://github.com/igtux/Quqa-Express",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igtux/Quqa-Express.git"
  },
  "bugs": "https://github.com/igtux/Quqa-Express/issues",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.ui.json",
    "test": "vitest run",
    "test:e2e": "vitest run test/e2e",
    "test:ui": "electron-vite build && playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "dist:win": "electron-vite build && electron-builder --win nsis portable --x64 && node scripts/checksums.mjs",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage",
    "test:smoke": "playwright test test/ui/smoke.spec.ts"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "ssh2": "^1.17.0",
    "typebox": "^1.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
